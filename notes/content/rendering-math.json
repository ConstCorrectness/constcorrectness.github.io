{"version":3,"kind":"Notebook","sha256":"3fd3d30c70c3f8fefb1520fd0755aeb6fc785ba34c4b01cb71533a7cfcb14191","slug":"rendering-math","location":"/rendering-math.ipynb","dependencies":[],"frontmatter":{"title":"3D Projection Mathematics","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"github":"https://github.com/constcorrectness/constcorrectness.github.io","exports":[{"format":"ipynb","filename":"rendering-math.ipynb","url":"/rendering-math-7597a9207f0b85988e1ea40276fff141.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"To render a 3D object onto a 2D screen (like in our React Three Fiber viewer), we use projection matrices. Here is how the math works in Python.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YyRhf9qQQ1"}],"key":"rmmJI2dFSS"}],"key":"vIF9JRjsAR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\n\ndef perspective_projection(point_3d, d=1):\n    x, y, z = point_3d\n    return np.array([x / (z/d), y / (z/d)])\n\n# Define a simple 3D cube vertex\npoint = np.array([10, 10, 20])\nprojected = perspective_projection(point)\n\nprint(f\"3D Point: {point} -> 2D Screen: {projected}\")","key":"TVkABOq93H"},{"type":"outputs","id":"-vr_OTQVPha8lmMi6yyWF","children":[],"key":"CmPqhhmGrG"}],"key":"hn3YOTH756"}],"key":"Su5kYnqeRg"},"references":{"cite":{"order":[],"data":{}}}}